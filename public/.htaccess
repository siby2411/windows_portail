<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si le fichier ou dossier physique existe, on le sert directement
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Sinon, on route tout vers index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

Options -Indexes
AddDefaultCharset UTF-8